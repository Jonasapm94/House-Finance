{
  "name": "house-finance",
  "version": "1.0.0",
  "private": true,
  "description": "A privacy-first personal finance dashboard for tracking household income and expenses. Runs entirely locally via Docker — no cloud services, no third-party data sharing.",
  "workspaces": ["backend", "frontend"],
  "scripts": {
    "dev": "docker compose up",
    "setup": "docker compose exec backend npm run migrate",
    "build": "npm-run-all2 -p 'build --workspace=backend' 'build --workspace=frontend'",
    "test": "npm-run-all2 -p 'test --workspace=backend' 'test --workspace=frontend'",
    "lint": "npm-run-all2 -p 'lint --workspace=backend' 'lint --workspace=frontend'",
    "format": "npm-run-all2 -p 'format --workspace=backend' 'format --workspace=frontend'",
    "format:check": "npm-run-all2 -p 'format:check --workspace=backend' 'format:check --workspace=frontend'",
    "prepare": "husky"
  },
  "devDependencies": {
    "npm-run-all2": "^7.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jonasapm94/House-Finance.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Jonasapm94/House-Finance/issues"
  },
  "homepage": "https://github.com/Jonasapm94/House-Finance#readme"
}
