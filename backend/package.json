{
  "name": "house-finance-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "migrate": "tsx node_modules/.bin/knex migrate:latest --knexfile src/knexfile.ts",
    "migrate:rollback": "tsx node_modules/.bin/knex migrate:rollback --knexfile src/knexfile.ts",
    "seed": "tsx node_modules/.bin/knex seed:run --knexfile src/knexfile.ts",
    "test:migrate": "tsx node_modules/.bin/knex migrate:latest --knexfile src/knexfile.ts --env test",
    "test:migrate:rollback": "tsx node_modules/.bin/knex migrate:rollback --knexfile src/knexfile.ts --env test",
    "test:create-db": "tsx -e \"import { Pool } from 'pg'; const pool = new Pool({ host: 'localhost', port: 5432, user: 'finance_user', password: 'finance_pass', database: 'postgres' }); pool.query('CREATE DATABASE house_finance_test').then(() => pool.end()).catch(e => { if (e.code !== '42P04') throw e; pool.end(); })\"",
    "test:reset": "npm run test:migrate:rollback && npm run test:migrate"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/multipart": "^9.0.0",
    "fast-xml-parser": "^5.1.0",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^4.0.2",
    "knex": "^3.1.0",
    "objection": "^3.1.5",
    "openai": "^6.34.0",
    "papaparse": "^5.5.2",
    "pg": "^8.13.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/form-data": "^2.2.1",
    "@types/node": "^22.13.4",
    "@types/papaparse": "^5.3.15",
    "@vitest/coverage-v8": "^3.0.6",
    "eslint": "^9.20.0",
    "form-data": "^4.0.5",
    "prettier": "^3.5.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1",
    "vitest": "^3.0.6"
  }
}
